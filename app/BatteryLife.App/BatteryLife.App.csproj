<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BatteryLife.App</RootNamespace>
    <AssemblyName>BatteryLife</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Unpackaged: runs as a plain exe (no MSIX), Windows App SDK bundled next to it. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <!-- Draws the per-device tray icons (DeviceTrayIcons.cs); H.NotifyIcon already brings this version. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <!-- Windows App SDK parts the app never calls (on-device AI, ML, semantic search, widgets).
         Excluding them here, plus DropUnusedWinAppSdkParts below, keeps about 58 MB out of the
         install. Bump these versions together with Microsoft.WindowsAppSDK, or the build fails
         with a package downgrade error (NU1605). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.7.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.5.96" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatteryLife.Logic\BatteryLife.Logic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Rust core runs as a child process; build it first with "cargo build (release)" in core/. -->
    <None Include="..\..\core\target\release\batterylife-core.exe" Link="batterylife-core.exe"
          CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\core\target\release\batterylife-core.exe')" />
  </ItemGroup>

</Project>
