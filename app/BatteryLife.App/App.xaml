<Application
    x:Class="BatteryLife.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Airport-sign palette (DESIGN.md). Yellow means "act now" and is used for nothing else.
                 Code reads these through Palette.Brush so a contrast theme swaps them too. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SignYellowBrush" Color="#FFD200" />
                    <SolidColorBrush x:Key="SignInkBrush" Color="#111111" />
                    <SolidColorBrush x:Key="SignGroundBrush" Color="#111111" />
                    <SolidColorBrush x:Key="SignRaisedBrush" Color="#1C1C1C" />
                    <SolidColorBrush x:Key="SignRuleBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="SignTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SignMutedBrush" Color="#A8A8A8" />
                </ResourceDictionary>
                <!-- Windows contrast themes: the sign maps onto the user's chosen system colors. -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SignYellowBrush" Color="{StaticResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SignInkBrush" Color="{StaticResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SignGroundBrush" Color="{StaticResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SignRaisedBrush" Color="{StaticResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SignRuleBrush" Color="{StaticResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SignTextBrush" Color="{StaticResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SignMutedBrush" Color="{StaticResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="SignFont">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="SignDisplayFont">Segoe UI Variable Display</FontFamily>
            <FontFamily x:Key="PictogramFont">Segoe Fluent Icons</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
