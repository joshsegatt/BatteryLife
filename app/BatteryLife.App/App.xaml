<Application
    x:Class="BatteryLife.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Airport-sign palette (DESIGN.md). Yellow means "act now" and is used for nothing else. -->
            <Color x:Key="SignYellow">#FFD200</Color>
            <Color x:Key="SignInk">#111111</Color>
            <Color x:Key="SignGround">#111111</Color>
            <Color x:Key="SignRaised">#1C1C1C</Color>
            <Color x:Key="SignRule">#2A2A2A</Color>
            <Color x:Key="SignText">#FFFFFF</Color>
            <Color x:Key="SignMuted">#A8A8A8</Color>
            <Color x:Key="SignCritical">#FF5A3C</Color>

            <SolidColorBrush x:Key="SignYellowBrush" Color="{StaticResource SignYellow}" />
            <SolidColorBrush x:Key="SignInkBrush" Color="{StaticResource SignInk}" />
            <SolidColorBrush x:Key="SignGroundBrush" Color="{StaticResource SignGround}" />
            <SolidColorBrush x:Key="SignRaisedBrush" Color="{StaticResource SignRaised}" />
            <SolidColorBrush x:Key="SignRuleBrush" Color="{StaticResource SignRule}" />
            <SolidColorBrush x:Key="SignTextBrush" Color="{StaticResource SignText}" />
            <SolidColorBrush x:Key="SignMutedBrush" Color="{StaticResource SignMuted}" />

            <FontFamily x:Key="SignFont">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="SignDisplayFont">Segoe UI Variable Display</FontFamily>
            <FontFamily x:Key="PictogramFont">Segoe Fluent Icons</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
